# Copy to .env in the repository root (used by both local runs and `docker run --env-file .env`).
# Never commit the real .env.

# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Vision model used for extraction (and chat, unless LLM_CHAT_MODEL is set).
# Any OpenRouter model with image input works.
LLM_MODEL=google/gemini-3.8-flash

# Comparison model, used only by scripts/compare_models.py (never by the app).
LLM_MODEL_ALT=anthropic/claude-sonnet-5

# Optional separate model for "Ask the Document" chat. Empty = use LLM_MODEL.
LLM_CHAT_MODEL=

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=10

# Optional paths for system binaries. Empty = found on PATH.
# Windows examples: C:\Program Files\Tesseract-OCR\tesseract.exe  and  C:\path\to\poppler\Library\bin
TESSERACT_CMD=
POPPLER_PATH=
